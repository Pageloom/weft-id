{
    "description": "WeftID OpenID Provider ({WEFTID_ISSUER})",
    "alias": "{ALIAS}",
    "server": {
        "discoveryUrl": "{WEFTID_ISSUER}/.well-known/openid-configuration"
    },
    "options": {
        "comment": "The suite's HtmlUnit browser cannot parse WeftID's ES2020 page scripts, so the JS that reveals the password form (passkey fallback) never runs. With CSS parsing off, Tailwind's `hidden` class has no effect and the form is interactable.",
        "browsercontrol_css_enable": false
    },
    "client": {
        "client_id": "{CLIENT1_ID}",
        "client_secret": "{CLIENT1_SECRET}"
    },
    "client2": {
        "client_id": "{CLIENT2_ID}",
        "client_secret": "{CLIENT2_SECRET}"
    },
    "client_secret_post": {
        "client_id": "{CLIENT3_ID}",
        "client_secret": "{CLIENT3_SECRET}"
    },
    "browser": [
        {
            "comment": "Interactive path: authorize -> login (email, password, MFA) -> consent -> suite callback. Every step is optional because an existing session or remembered consent skips it. The email step matches /login* because login_hint and re-authentication send the browser to /login?prefill_email=...",
            "match": "{WEFTID_ISSUER}/oauth2/authorize*",
            "tasks": [
                {
                    "task": "Login: email step",
                    "optional": true,
                    "match": "{WEFTID_ISSUER}/login*",
                    "commands": [
                        ["text", "id", "email", "{USER_EMAIL}"],
                        ["click", "css", "#emailForm button[type='submit']"]
                    ]
                },
                {
                    "task": "Login: password step",
                    "optional": true,
                    "match": "{WEFTID_ISSUER}/login?*show_password*",
                    "commands": [
                        ["wait", "id", "loginForm", 10],
                        ["text", "name", "password", "{USER_PASSWORD}"],
                        ["click", "css", "#loginForm button[type='submit']"]
                    ]
                },
                {
                    "task": "Login: MFA step (BYPASS_OTP accepts any 6 digits)",
                    "optional": true,
                    "match": "{WEFTID_ISSUER}/mfa/verify*",
                    "commands": [
                        ["text", "id", "code", "123456"],
                        ["click", "css", "#mfaVerifyForm button[type='submit']"]
                    ]
                },
                {
                    "task": "Consent",
                    "optional": true,
                    "match": "{WEFTID_ISSUER}/oauth2/authorize*",
                    "commands": [
                        ["click", "css", "button[name='action'][value='allow']"]
                    ]
                },
                {
                    "task": "Verify complete",
                    "match": "*/test/*/callback*",
                    "commands": [
                        ["wait", "id", "submission_complete", 10]
                    ]
                }
            ]
        },
        {
            "comment": "End-session path (RP-Initiated OP plan). A verified id_token_hint signs the user out at once and returns to the suite's post_logout_redirect. The modules without one see the confirmation page, click Sign out, and the signed-out page fulfils their screenshot placeholder. The first task also matches the signed-out page, where its optional click finds nothing and is skipped.",
            "match": "{WEFTID_ISSUER}/oauth2/logout*",
            "tasks": [
                {
                    "task": "Confirm sign-out",
                    "optional": true,
                    "match": "{WEFTID_ISSUER}/oauth2/logout*",
                    "commands": [
                        ["click", "css", "#logout-confirm button[name='confirm']", "optional"]
                    ]
                },
                {
                    "task": "Signed-out page",
                    "optional": true,
                    "match": "{WEFTID_ISSUER}/oauth2/logout/done*",
                    "commands": [
                        ["wait", "id", "logout-done", 10, "signed out", "update-image-placeholder-optional"]
                    ]
                },
                {
                    "task": "Post-logout redirect back to the suite",
                    "optional": true,
                    "match": "*/test/*/post_logout_redirect*"
                }
            ]
        }
    ],
    "override": {
        "oidcc-prompt-login": {
            "browser": [
                {
                    "comment": "Second authorization must show the login page again; the page snapshot fulfils the suite's placeholder.",
                    "match": "{WEFTID_ISSUER}/oauth2/authorize*",
                    "tasks": [
                        {
                            "task": "Login: email step",
                            "optional": true,
                            "match": "{WEFTID_ISSUER}/login*",
                            "commands": [
                                ["wait", "xpath", "//*", 10, "Sign In", "update-image-placeholder-optional"],
                                ["text", "id", "email", "{USER_EMAIL}"],
                                ["click", "css", "#emailForm button[type='submit']"]
                            ]
                        },
                        {
                            "task": "Login: password step",
                            "optional": true,
                            "match": "{WEFTID_ISSUER}/login?*show_password*",
                            "commands": [
                                ["wait", "id", "loginForm", 10],
                                ["text", "name", "password", "{USER_PASSWORD}"],
                                ["click", "css", "#loginForm button[type='submit']"]
                            ]
                        },
                        {
                            "task": "Login: MFA step (BYPASS_OTP accepts any 6 digits)",
                            "optional": true,
                            "match": "{WEFTID_ISSUER}/mfa/verify*",
                            "commands": [
                                ["text", "id", "code", "123456"],
                                ["click", "css", "#mfaVerifyForm button[type='submit']"]
                            ]
                        },
                        {
                            "task": "Consent (snapshot fulfils the placeholder when no login page was shown, so the auth_time check reports the gap instead of a timeout)",
                            "optional": true,
                            "match": "{WEFTID_ISSUER}/oauth2/authorize*",
                            "commands": [
                                ["wait", "xpath", "//*", 10, "requesting access", "update-image-placeholder-optional"],
                                ["click", "css", "button[name='action'][value='allow']"]
                            ]
                        },
                        {
                            "task": "Verify complete",
                            "match": "*/test/*/callback*",
                            "commands": [
                                ["wait", "id", "submission_complete", 10]
                            ]
                        }
                    ]
                }
            ]
        },
        "oidcc-max-age-1": {
            "browser": [
                {
                    "comment": "Same as oidcc-prompt-login: the expired max_age must force a fresh login.",
                    "match": "{WEFTID_ISSUER}/oauth2/authorize*",
                    "tasks": [
                        {
                            "task": "Login: email step",
                            "optional": true,
                            "match": "{WEFTID_ISSUER}/login*",
                            "commands": [
                                ["wait", "xpath", "//*", 10, "Sign In", "update-image-placeholder-optional"],
                                ["text", "id", "email", "{USER_EMAIL}"],
                                ["click", "css", "#emailForm button[type='submit']"]
                            ]
                        },
                        {
                            "task": "Login: password step",
                            "optional": true,
                            "match": "{WEFTID_ISSUER}/login?*show_password*",
                            "commands": [
                                ["wait", "id", "loginForm", 10],
                                ["text", "name", "password", "{USER_PASSWORD}"],
                                ["click", "css", "#loginForm button[type='submit']"]
                            ]
                        },
                        {
                            "task": "Login: MFA step (BYPASS_OTP accepts any 6 digits)",
                            "optional": true,
                            "match": "{WEFTID_ISSUER}/mfa/verify*",
                            "commands": [
                                ["text", "id", "code", "123456"],
                                ["click", "css", "#mfaVerifyForm button[type='submit']"]
                            ]
                        },
                        {
                            "task": "Consent (snapshot fulfils the placeholder when no login page was shown, so the auth_time check reports the gap instead of a timeout)",
                            "optional": true,
                            "match": "{WEFTID_ISSUER}/oauth2/authorize*",
                            "commands": [
                                ["wait", "xpath", "//*", 10, "requesting access", "update-image-placeholder-optional"],
                                ["click", "css", "button[name='action'][value='allow']"]
                            ]
                        },
                        {
                            "task": "Verify complete",
                            "match": "*/test/*/callback*",
                            "commands": [
                                ["wait", "id", "submission_complete", 10]
                            ]
                        }
                    ]
                }
            ]
        },
        "oidcc-ensure-registered-redirect-uri": {
            "browser": [
                {
                    "comment": "WeftID renders an error page and never redirects for an unregistered redirect_uri.",
                    "match": "{WEFTID_ISSUER}/oauth2/authorize*",
                    "tasks": [
                        {
                            "task": "Expect redirect_uri error page",
                            "match": "{WEFTID_ISSUER}/oauth2/authorize*",
                            "commands": [
                                ["wait", "xpath", "//*", 10, "redirect_uri", "update-image-placeholder"]
                            ]
                        }
                    ]
                }
            ]
        },
        "oidcc-ensure-redirect-uri-in-authorization-request": {
            "browser": [
                {
                    "comment": "Missing redirect_uri must render an error page, never redirect.",
                    "match": "{WEFTID_ISSUER}/oauth2/authorize*",
                    "tasks": [
                        {
                            "task": "Expect redirect_uri error page",
                            "match": "{WEFTID_ISSUER}/oauth2/authorize*",
                            "commands": [
                                ["wait", "xpath", "//*", 10, "redirect_uri", "update-image-placeholder"]
                            ]
                        }
                    ]
                }
            ]
        },
        "oidcc-redirect-uri-query-added": {
            "browser": [
                {
                    "comment": "A redirect_uri with an extra query component does not match the registered one.",
                    "match": "{WEFTID_ISSUER}/oauth2/authorize*",
                    "tasks": [
                        {
                            "task": "Expect redirect_uri error page",
                            "match": "{WEFTID_ISSUER}/oauth2/authorize*",
                            "commands": [
                                ["wait", "xpath", "//*", 10, "redirect_uri", "update-image-placeholder"]
                            ]
                        }
                    ]
                }
            ]
        },
        "oidcc-ensure-request-object-with-redirect-uri": {
            "browser": [
                {
                    "comment": "Request objects are rejected (request_not_supported); the plain query carries an unregistered redirect_uri (the registered one is inside the request object), so WeftID renders the error page and never redirects.",
                    "match": "{WEFTID_ISSUER}/oauth2/authorize*",
                    "tasks": [
                        {
                            "task": "Expect redirect_uri error page",
                            "match": "{WEFTID_ISSUER}/oauth2/authorize*",
                            "commands": [
                                ["wait", "xpath", "//*", 10, "redirect_uri", "update-image-placeholder"]
                            ]
                        }
                    ]
                }
            ]
        },
        "oidcc-redirect-uri-query-mismatch": {
            "browser": [
                {
                    "comment": "A redirect_uri whose query differs from the registered one is rejected.",
                    "match": "{WEFTID_ISSUER}/oauth2/authorize*",
                    "tasks": [
                        {
                            "task": "Expect redirect_uri error page",
                            "match": "{WEFTID_ISSUER}/oauth2/authorize*",
                            "commands": [
                                ["wait", "xpath", "//*", 10, "redirect_uri", "update-image-placeholder"]
                            ]
                        }
                    ]
                }
            ]
        },
        "oidcc-rp-initiated-logout-bad-id-token-hint": {
            "browser": [
                "$browser[0]",
                {
                    "comment": "The id_token_hint is signed by the suite, not WeftID. WeftID must not redirect back; it shows the sign-out confirmation page, whose snapshot fulfils the placeholder.",
                    "match": "{WEFTID_ISSUER}/oauth2/logout*",
                    "tasks": [
                        {
                            "task": "Expect sign-out confirmation page",
                            "match": "{WEFTID_ISSUER}/oauth2/logout*",
                            "commands": [
                                ["wait", "id", "logout-confirm", 10, "Sign out", "update-image-placeholder"]
                            ]
                        }
                    ]
                }
            ]
        },
        "oidcc-rp-initiated-logout-modified-id-token-hint": {
            "browser": [
                "$browser[0]",
                {
                    "comment": "The id_token_hint has been changed to alg:none. WeftID must not redirect back; it shows the sign-out confirmation page, whose snapshot fulfils the placeholder.",
                    "match": "{WEFTID_ISSUER}/oauth2/logout*",
                    "tasks": [
                        {
                            "task": "Expect sign-out confirmation page",
                            "match": "{WEFTID_ISSUER}/oauth2/logout*",
                            "commands": [
                                ["wait", "id", "logout-confirm", 10, "Sign out", "update-image-placeholder"]
                            ]
                        }
                    ]
                }
            ]
        },
        "oidcc-rp-initiated-logout-no-id-token-hint": {
            "browser": [
                "$browser[0]",
                {
                    "comment": "A post_logout_redirect_uri without an id_token_hint. WeftID must not redirect back; it shows the sign-out confirmation page, whose snapshot fulfils the placeholder.",
                    "match": "{WEFTID_ISSUER}/oauth2/logout*",
                    "tasks": [
                        {
                            "task": "Expect sign-out confirmation page",
                            "match": "{WEFTID_ISSUER}/oauth2/logout*",
                            "commands": [
                                ["wait", "id", "logout-confirm", 10, "Sign out", "update-image-placeholder"]
                            ]
                        }
                    ]
                }
            ]
        },
        "oidcc-rp-initiated-logout-bad-post-logout-redirect-uri": {
            "browser": [
                "$browser[0]",
                {
                    "comment": "The post_logout_redirect_uri is not registered. WeftID must not redirect back; it shows the sign-out confirmation page, whose snapshot fulfils the placeholder.",
                    "match": "{WEFTID_ISSUER}/oauth2/logout*",
                    "tasks": [
                        {
                            "task": "Expect sign-out confirmation page",
                            "match": "{WEFTID_ISSUER}/oauth2/logout*",
                            "commands": [
                                ["wait", "id", "logout-confirm", 10, "Sign out", "update-image-placeholder"]
                            ]
                        }
                    ]
                }
            ]
        },
        "oidcc-rp-initiated-logout-query-added-to-post-logout-redirect-uri": {
            "browser": [
                "$browser[0]",
                {
                    "comment": "The registered post_logout_redirect_uri with '?foo=bar' added does not match. WeftID must not redirect back; it shows the sign-out confirmation page, whose snapshot fulfils the placeholder.",
                    "match": "{WEFTID_ISSUER}/oauth2/logout*",
                    "tasks": [
                        {
                            "task": "Expect sign-out confirmation page",
                            "match": "{WEFTID_ISSUER}/oauth2/logout*",
                            "commands": [
                                ["wait", "id", "logout-confirm", 10, "Sign out", "update-image-placeholder"]
                            ]
                        }
                    ]
                }
            ]
        }
    }
}

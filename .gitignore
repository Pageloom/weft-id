.DS_Store
.env
.coverage
.idea/
.devcerts/
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.testmondata*
.claude/settings.local.json
.claude/worktrees/
/storage/*
app/storage/

# Frontend build artifacts
static/css/output.css
tailwindcss-*

# Iteration planning files (managed by /lead skill, never committed)
.claude/ITERATION_*.md

# Claude Code runtime state (ScheduleWakeup ownership lock)
.claude/scheduled_tasks.lock

# Built documentation site (built at Docker image time or via `make docs`)
site/

# Local SCIM testbeds (Authentik, Okta-emulator, etc.). The fixtures
# themselves are intentionally not committed; see docs for setup. Anyone
# who bootstraps a testbed under dev/ keeps it out of source.
dev/authentik/
dev/scim-testbed/

# OIDC conformance suite: rendered config (holds client secrets) and the
# exported results live outside source. The runtime itself is under
# ~/.local/share/weft-id/oidc-conformance/ (see dev/oidc-conformance.sh).
dev/oidc-conformance/export/
dev/oidc-conformance/config.json
